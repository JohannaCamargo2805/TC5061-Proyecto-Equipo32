# Plantilla de variables de entorno del proyecto MiBici (Equipo 32).
# Copia este archivo como .env (ignorado por Git) y ajusta los valores locales.
# NUNCA escribas contraseñas, tokens ni llaves en archivos versionados.

# Servidor de tracking de MLflow (respaldado por SQLite, ver README)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Silencia una sugerencia informativa de MLflow en la consola
MLFLOW_DISABLE_AGENT_HINT=1

# Si algún día se usa un servidor remoto con autenticación, las credenciales van SOLO aquí:
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# ---------------------------------------------------------------------------------------------
# docker-compose.yml (entrega 6). Todas tienen valor por defecto; descomenta solo lo que cambies.
# ---------------------------------------------------------------------------------------------
# Puertos publicados en 127.0.0.1
# API_PUERTO=8000
# MLFLOW_PUERTO=5000
# LOCUST_PUERTO=8089
# Modelo que sirve la API: alias o versión del registry de Compose, o la copia empaquetada
# MODELO_URI=models:/mibici-equipo32-p1-demanda@champion
# MODELO_URI=/app/models/servicio
# Tamaño de la réplica de la API (lo que mide la prueba de carga y usa el análisis FinOps)
# API_WORKERS=1
# API_CPUS=1.0
# API_MEMORIA=1g
# API_ACCESS_LOG=true
# Prueba de carga (perfil "carga"): escalones|humo|lote|asincrono
# ESCENARIO=escalones
# ESCALONES=10:45,25:45,50:45,100:45,150:45,200:45,250:45,300:45
# DURACION=60
# Imágenes ya publicadas por el pipeline (GHCR) en lugar de construirlas
# API_IMAGEN=ghcr.io/johannacamargo2805/mibici-p1-api:latest
# MLFLOW_IMAGEN=ghcr.io/johannacamargo2805/mibici-mlflow:latest
# Imagen base y de Redis (por ejemplo, un registro espejo de la organización)
# IMAGEN_PYTHON=docker.io/library/python:3.14.8-slim-trixie@sha256:...
# REDIS_IMAGEN=docker.io/library/redis:8.10.3-alpine3.23
