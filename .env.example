# Plantilla de variables de entorno del proyecto MiBici (Equipo 32).
# Copia este archivo como .env (ignorado por Git) y ajusta los valores locales.
# NUNCA escribas contraseñas, tokens ni llaves en archivos versionados.

# Servidor de tracking de MLflow (respaldado por SQLite, ver README)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Silencia una sugerencia informativa de MLflow en la consola
MLFLOW_DISABLE_AGENT_HINT=1

# Si algún día se usa un servidor remoto con autenticación, las credenciales van SOLO aquí:
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
