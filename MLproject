# MLflow Project del Equipo 32 (TC5061): MiBici, Guadalajara.
# Los parámetros con valor "config" toman su valor de mibici/config.py: aquí no
# se repiten rutas, fechas ni semillas. "auto" = lo decide el código (nombre de
# la corrida, mejor candidata). Se usan palabras y no cadenas vacías porque
# `mlflow run` en Windows (cmd /c) no transmite bien los argumentos vacíos.
name: mibici-equipo32

python_env: python_env.yaml

entry_points:
  # Ingesta reproducible y versión de datos (data/manifest.json).
  ingest:
    parameters:
      raw_source: {type: string, default: config}  # carpeta con copias locales de los CSV; config = descargar de las URLs de config.py
    command: "python -m mibici.dataset --raw-source {raw_source}"

  # Entrena UN modelo de UNA pregunta y registra métricas, artefactos y modelo.
  train:
    parameters:
      question: {type: string, default: p1}      # p1 | p2 | p3
      model: {type: string, default: config}     # config = modelo por defecto de config.py
      stage: {type: string, default: config}     # baseline | candidate (config = catálogo)
      run_name: {type: string, default: auto}
      n_estimators: {type: string, default: config}
      max_depth: {type: string, default: config}
      min_samples_leaf: {type: string, default: config}
      max_features: {type: string, default: config}
      max_samples: {type: string, default: config}
      learning_rate: {type: string, default: config}
      max_iter: {type: string, default: config}
      max_leaf_nodes: {type: string, default: config}
      l2_regularization: {type: string, default: config}
      alpha: {type: string, default: config}
      C: {type: string, default: config}
      class_weight: {type: string, default: config}
      k: {type: string, default: config}
      linkage: {type: string, default: config}
      covariance_type: {type: string, default: config}
      n_init: {type: string, default: config}
      lag_dias: {type: string, default: config}
      extra_params: {type: string, default: "{}"} # JSON con otros hiperparámetros
      from_search: {type: string, default: "no"}   # run_id de una búsqueda o latest: usa su mejor combinación
    command: >-
      python -m mibici.modeling.train --question {question} --model {model}
      --stage {stage} --run-name {run_name}
      --n-estimators {n_estimators} --max-depth {max_depth}
      --min-samples-leaf {min_samples_leaf} --max-features {max_features}
      --max-samples {max_samples} --learning-rate {learning_rate} --max-iter {max_iter}
      --max-leaf-nodes {max_leaf_nodes} --l2-regularization {l2_regularization}
      --alpha {alpha} --C {C} --class-weight {class_weight} --k {k} --linkage {linkage}
      --covariance-type {covariance_type} --n-init {n_init} --lag-dias {lag_dias}
      --extra-params {extra_params} --from-search {from_search}

  # Búsqueda de hiperparámetros: corrida padre + una corrida hija (nested) por combinación.
  search:
    parameters:
      question: {type: string, default: p1}
      model: {type: string, default: config}     # config = BUSQUEDAS de config.py
      grid: {type: string, default: config}      # JSON; config = rejilla de config.py
      run_name: {type: string, default: auto}
    command: >-
      python -m mibici.modeling.search --question {question} --model {model}
      --grid {grid} --run-name {run_name}

  # Model Registry: registra la corrida elegida y le asigna el alias champion (y challenger).
  register:
    parameters:
      question: {type: string, default: p1}
      run_id: {type: string, default: auto}         # auto = regla de selección de config.py
      challenger_run_id: {type: string, default: auto}
    command: >-
      python -m mibici.modeling.registry --question {question} --run-id {run_id}
      --challenger-run-id {challenger_run_id}

  # Verifica que cada modelo en producción carga por nombre y alias y reproduce su métrica.
  verify:
    parameters:
      question: {type: string, default: all}
      alias: {type: string, default: champion}
    command: "python -m mibici.modeling.predict --question {question} --alias {alias}"
